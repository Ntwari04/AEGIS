# Local development. Copy to apps/api/.env (gitignored). Production values come from infra/.env via docker-compose.
DATABASE_URL=postgresql://aegisops:CHANGE_ME@127.0.0.1:15432/aegisops
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:16379
WEB_ORIGIN=http://localhost:13000
KEYCLOAK_ISSUER=http://localhost:18080/realms/aegisops
KEYCLOAK_JWKS_URI=http://localhost:18080/realms/aegisops/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=aegisops-api
