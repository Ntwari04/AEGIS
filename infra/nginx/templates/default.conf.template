# This file is a TEMPLATE. On container start, the official nginx image's
# entrypoint runs envsubst over every *.template file in /etc/nginx/templates
# and writes the result to /etc/nginx/conf.d/<name-without-.template>, using
# whatever environment variables are set on the container (here: $DOMAIN,
# passed in from infra/.env via docker-compose.yml). Only $DOMAIN is substituted;
# nginx's own $variables are left alone.
#
# Phase 3 will generate one extra server block per deployed project into conf.d/
# alongside this file; nothing here needs to change for that.

# Docker's embedded DNS. Backends are resolved per-request through variables, so Nginx
# starts and keeps working even when a backend container is down or being replaced.
resolver 127.0.0.11 valid=10s ipv6=off;

# Per-project routes written by the deployer (apps/api/src/deployments/nginx-config.ts).
include /etc/nginx/conf.d/managed/*.conf;

limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

# Catch-all: a request whose Host matches no server_name is dropped. Without an explicit default_server,
# Nginx uses the FIRST server defined, and the managed project routes (included above) would win that
# race, so an unknown Host would be proxied to whichever project container was deployed first.
server {
    listen 80 default_server;
    listen 443 ssl http2 default_server;
    server_name _;

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 444;
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN} auth.${DOMAIN} grafana.${DOMAIN};
    return 301 https://$host$request_uri;
}

# ---- Dashboard + API ----
server {
    listen 443 ssl http2;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    set $web http://web:3000;
    set $api http://api:4000;

    # Auth.js stores the encrypted session (access + refresh + id tokens) in chunked cookies; the
    # Set-Cookie headers on /api/auth/callback/* exceed Nginx's default 4-8k proxy buffer (-> 502
    # "upstream sent too big header") and the cookies sent back can exceed the default request-header limit.
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    large_client_header_buffers 4 32k;

    # Prometheus metrics are for Prometheus, on the internal network only (FR-MON-1). Without this line the request
    # would fall through to the web app; being explicit keeps it a hard 404 whatever the web app does.
    location = /metrics { return 404; }

    location /api/v1/ {
        limit_req zone=api burst=40 nodelay;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass $web;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}

# ---- Keycloak (identity provider) ----
server {
    listen 443 ssl http2;
    server_name auth.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    set $kc http://keycloak:8080;

    # The admin console, the master realm and operational endpoints are NOT reachable from the
    # internet. Administer Keycloak via `docker exec ... kcadm.sh` (infra/keycloak/bootstrap.sh).
    location ~ ^/(admin|realms/master|metrics|health) { return 404; }

    # Only the application realm's OIDC + account endpoints are public.
    location ~ ^/(realms/aegisops|resources|js) {
        proxy_pass $kc;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }

    location / { return 404; }
}

# ---- Grafana (dashboards, logs) ----
# Single sign-on through Keycloak (Grafana's own login form is disabled); only platform_admin, devops_engineer and
# auditor roles are admitted (see GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH in docker-compose.yml).
server {
    listen 443 ssl http2;
    server_name grafana.${DOMAIN};

    ssl_certificate     /etc/nginx/certs/cert.pem;
    ssl_certificate_key /etc/nginx/certs/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    set $grafana http://grafana:3000;

    location = /metrics { return 404; }

    location / {
        proxy_pass $grafana;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
    }

    # Grafana Live (dashboard auto-refresh over WebSocket)
    location /api/live/ {
        proxy_pass $grafana;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
