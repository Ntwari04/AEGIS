# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it. On the droplet: chmod 600 .env
# Generate each secret with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# The domain this droplet serves, e.g. aegisops.yourcompany.com or yourcompany.com.
# Dashboard: https://$DOMAIN   Keycloak: https://auth.$DOMAIN   (the Cloudflare origin
# cert from Phase 1 covers *.$DOMAIN). This is the ONLY place the domain is configured.
DOMAIN=example.com

# --- Postgres ---
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
AEGISOPS_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- Keycloak ---
# Temporary bootstrap admin. Replace it with a permanent admin and delete this one
# right after first start: see docs/phase2-core-platform.md ("Rotate the bootstrap admin").
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Secret of the confidential "aegisops-web" OIDC client. Keycloak is seeded with it
# from realm-aegisops.json; the Next.js app presents it. Rotate on a schedule (PRD 8.3).
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# --- Next.js (Auth.js) ---
# Encrypts the session cookie. Must be a long random value.
AUTH_SECRET=CHANGE_ME
# Deployer: numeric gid owning /var/run/docker.sock on the droplet (stat -c %g /var/run/docker.sock).
DOCKER_GID=999
# Name of the CI workflow whose successful completion triggers a deploy.
GITHUB_DEPLOY_WORKFLOW=Build image
# Only needed if your GHCR images are PRIVATE: a classic PAT with read:packages (GHCR does not accept GitHub App tokens).
GHCR_USERNAME=
GHCR_TOKEN=

# --- Per-environment secrets (FR-SEC-5) ---
# 32 random bytes, base64. Encrypts secret env var values at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Losing this key makes stored secret values unrecoverable; back it up like any other root secret. Rotate by re-entering values.
SECRETS_ENCRYPTION_KEY=CHANGE_ME

# --- GitHub App ---
# Create the App (not a personal token): Contents:read, Metadata:read, Deployments:read+write,
# Commit statuses:read+write; subscribe to the "Workflow run" event; webhook URL
# https://$DOMAIN/api/v1/webhooks/github. Save its private key to infra/secrets/github-app.pem (gitignored).
GITHUB_APP_ID=0
GITHUB_INSTALLATION_ID=0
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Same value as the App's webhook secret. Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=CHANGE_ME
