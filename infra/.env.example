# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it. On the droplet: chmod 600 .env
# Generate each secret with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# The domain this droplet serves, e.g. aegisops.yourcompany.com or yourcompany.com.
# Dashboard: https://$DOMAIN   Keycloak: https://auth.$DOMAIN   (the Cloudflare origin
# cert from Phase 1 covers *.$DOMAIN). This is the ONLY place the domain is configured.
DOMAIN=example.com

# --- Postgres ---
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
AEGISOPS_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- Keycloak ---
# Temporary bootstrap admin. Replace it with a permanent admin and delete this one
# right after first start: see docs/phase2-core-platform.md ("Rotate the bootstrap admin").
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Secret of the confidential "aegisops-web" OIDC client. Keycloak is seeded with it
# from realm-aegisops.json; the Next.js app presents it. Rotate on a schedule (PRD 8.3).
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# --- Next.js (Auth.js) ---
# Encrypts the session cookie. Must be a long random value.
AUTH_SECRET=CHANGE_ME
# Deployer: numeric gid owning /var/run/docker.sock on the droplet (stat -c %g /var/run/docker.sock).
DOCKER_GID=999
# Name of the CI workflow whose successful completion triggers a deploy.
GITHUB_DEPLOY_WORKFLOW=Build image
# Only needed if your GHCR images are PRIVATE: a classic PAT with read:packages (GHCR does not accept GitHub App tokens).
GHCR_USERNAME=
GHCR_TOKEN=

# --- Per-environment secrets (FR-SEC-5) ---
# 32 random bytes, base64. Encrypts secret env var values at rest (AES-256-GCM). Generate: openssl rand -base64 32
# Losing this key makes stored secret values unrecoverable; back it up like any other root secret. Rotate by re-entering values.
SECRETS_ENCRYPTION_KEY=CHANGE_ME

# --- Monitoring (Phase 4) ---
# Both are generated for you by:  node infra/scripts/ensure-secrets.mjs   (adds only what is missing; prints no values)
# Break-glass Grafana admin. The login form is disabled; everyone signs in through Keycloak.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Secret of the "aegisops-grafana" Keycloak client. For a realm created before Phase 4, run once:
#   docker cp infra/keycloak/bootstrap.sh aegisops-keycloak:/tmp/bootstrap.sh
#   docker exec -e GRAFANA_ORIGIN=https://grafana.$DOMAIN -e GRAFANA_OAUTH_SECRET=... aegisops-keycloak sh /tmp/bootstrap.sh add-grafana-client
GRAFANA_OAUTH_SECRET=CHANGE_ME
# Secret of the "aegisops-admin" Keycloak client: the service account behind the Users screen. It can create, disable and re-role every
# account, so treat it like a master key. Generated by ensure-secrets.mjs. For a realm created before the Users screen, run once:
#   docker cp infra/keycloak/bootstrap.sh aegisops-keycloak:/tmp/bootstrap.sh
#   docker exec -e KEYCLOAK_ADMIN_CLIENT_SECRET=... aegisops-keycloak sh /tmp/bootstrap.sh add-admin-client
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME
# Where alerts are sent (FR-MON-4). Set at least one; with neither, alerts show only on the dashboard / Alertmanager.
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=CHANGE_ME

# --- Backups and database management (Phase 5) ---
# Generated for you by:  node infra/scripts/ensure-secrets.mjs   (adds only what is missing; prints no values)
# Roles the data worker uses; created by infra/postgres/init/02-data-roles.sh (see docs/phase5-data.md for an existing install).
AEGIS_BACKUP_DB_PASSWORD=CHANGE_ME
AEGIS_PROVISIONER_DB_PASSWORD=CHANGE_ME
# AES-256-GCM key for backup archives (32 random bytes, base64).
# LOSING THIS KEY MAKES EVERY BACKUP UNREADABLE. Keep a copy somewhere other than this server (e.g. a password manager).
BACKUP_ENCRYPTION_KEY=CHANGE_ME
# Restore time objective a drill is held to, in seconds (PRD 7: RTO 4 hours).
BACKUP_RTO_SECONDS=14400
# Off-host object storage for encrypted backups (FR-BACKUP-2). Any S3-compatible service, e.g. DigitalOcean Spaces:
#   S3_ENDPOINT=https://fra1.digitaloceanspaces.com   S3_REGION=fra1   S3_BUCKET=your-bucket
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false

# --- GitHub App ---
# Create the App (not a personal token): Contents:read, Metadata:read, Deployments:read+write,
# Commit statuses:read+write; subscribe to the "Workflow run" event; webhook URL
# https://$DOMAIN/api/v1/webhooks/github. Save its private key to infra/secrets/github-app.pem (gitignored).
GITHUB_APP_ID=0
GITHUB_INSTALLATION_ID=0
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Same value as the App's webhook secret. Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=CHANGE_ME
